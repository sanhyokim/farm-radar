# このファイルを .env という名前でコピーして使います（.env は Git にコミットされません）。
# 秘密鍵やシードフレーズはここにも、どこにも書かないでください。このシステムは使いません。

# Alchemy の API キー（任意）。設定すると Alchemy の RPC を優先して使います。
# 空のままなら Robinhood Chain 公式の公開RPCを使います。
ALCHEMY_API_KEY=

# 予備のRPC（任意）。カンマ区切りで複数指定できます。config.yaml の rpc.extra_urls に追加されます。
EXTRA_RPC_URLS=

# 画面をiPhoneなどほかの機器から見るとき（任意）。0.0.0.0 にすると、同じWi-Fiの機器から
# http://<パソコンのIPアドレス>:18000 で開けます。空のままならこのパソコンからだけ開けます（127.0.0.1）。
# 画面は読み取り専用ですが、家のWi-Fiだけで使い、外のネットワークには公開しないでください。
FARM_RADAR_BIND=

# Telegram の通知（M4。任意）。BotFather で作ったボットのトークンと、あなたの Telegram の ID（数字）。
# トークンは合言葉と同じです。ここにだけ書き、チャットやスクリーンショットに出さないでください。
# 両方書くと、判定の変化・エラー・毎朝8時のレポートが届き、/status で状況を聞けます。
# ボットは TELEGRAM_OWNER_ID の人にだけ返事をします。空のままなら送らず、画面の「学ぶ」タブに残すだけです。
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# 新しい版を今のパソコンで並べて動かすとき（作り直し SPEC 13.4）だけ書きます。今の版の .env には書かないでください。
# FARM_RADAR_PORT: 画面のポート（並べた版は 18001）。COMPOSE_PROJECT_NAME: docker compose のプロジェクト名（今の版と分ける）。
# FARM_RADAR_CHAIN_READS=off: チェーンの読み取り（15分ごとの収集）を止め、一覧の保存だけを動かす。
# FARM_RADAR_PORT=18001
# COMPOSE_PROJECT_NAME=farm-radar-v2
# FARM_RADAR_CHAIN_READS=off
