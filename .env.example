# このファイルを .env という名前でコピーして使います（.env は Git にコミットされません）。
# 秘密鍵やシードフレーズはここにも、どこにも書かないでください。このシステムは使いません。

# Alchemy の API キー（任意）。設定すると Alchemy の RPC を優先して使います。
# 空のままなら Robinhood Chain 公式の公開RPCを使います。
ALCHEMY_API_KEY=

# 予備のRPC（任意）。カンマ区切りで複数指定できます。config.yaml の rpc.extra_urls に追加されます。
EXTRA_RPC_URLS=

# 画面をiPhoneなどほかの機器から見るとき（任意）。0.0.0.0 にすると、同じWi-Fiの機器から
# http://<パソコンのIPアドレス>:18000 で開けます。空のままならこのパソコンからだけ開けます（127.0.0.1）。
# 画面は読み取り専用ですが、家のWi-Fiだけで使い、外のネットワークには公開しないでください。
FARM_RADAR_BIND=
